# Application
ENVIRONMENT=development
DEBUG=true

# Security — CHANGE THIS in production (generate: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars

# Database
DATABASE_URL=postgresql+asyncpg://hospital_user:hospital_pass@localhost:5433/hospital

# Redis
REDIS_URL=redis://localhost:6379

# CORS — comma-separated origins allowed
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Twilio (optional — for SMS/WhatsApp feedback notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
